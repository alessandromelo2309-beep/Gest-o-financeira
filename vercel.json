{
  "services": {
    "api": {
      "root": "api/"
    },
    "frontend": {
      "root": "frontend/",
      "framework": "create-react-app",
      "installCommand": "npm install",
      "buildCommand": "npm run build",
      "outputDirectory": "build"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
